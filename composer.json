{
    "name": "justinholtweb/craft-sevvies",
    "description": "sevDesk invoicing for Craft Commerce \u2014 turn paid orders into correct German bookkeeping documents, with the right VAT rule, every time.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "commerce",
        "sevdesk",
        "invoicing",
        "accounting",
        "buchhaltung",
        "gobd",
        "datev"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0",
        "craftcms/commerce": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\sevvies\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Sevvies",
        "handle": "sevvies",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-sevvies/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-sevvies/main/CHANGELOG.md",
        "class": "justinholtweb\\sevvies\\Plugin"
    }
}
